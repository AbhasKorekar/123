        ". Extensions: We’re now working with examples that are complex\n",
        "enough that they can be extended in any number of ways. Use one of the\n",
        "example programs from this chapter, and extend it by adding new keys and\n",
        "values, changing the context of the program, or improving the formatting of\n",
        "the output.\n"
      ],
      "metadata": {
        "id": "f4YpOOmb9_Cz"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "cities = {\n",
        "    'mumbai': {\n",
        "        'country': 'india',\n",
        "        'population': 20_000_000,\n",
        "        'fact': 'Mumbai is home to Bollywood.',\n",
        "        'language': 'Marathi',\n",
        "        'famous_place': 'Gateway of India',\n",
        "    },\n",
        "    'paris': {\n",
        "        'country': 'france',\n",
        "        'population': 2_100_000,\n",
        "        'fact': 'Paris is famous for the Eiffel Tower.',\n",
        "        'language': 'French',\n",
        "        'famous_place': 'Louvre Museum',\n",
        "    },\n",
        "    'tokyo': {\n",
        "        'country': 'japan',\n",
        "        'population': 14_000_000,\n",
        "        'fact': 'Tokyo is known for its advanced technology.',\n",
        "        'language': 'Japanese',\n",
        "        'famous_place': 'Tokyo Tower',\n",
        "    },\n",
        "}\n",
        "\n",
        "for city, information in cities.items():\n",
        "    print(\"\\n\" + \"=\" * 30)\n",
        "    print(f\"CITY: {city.upper()}\")\n",
        "    print(\"=\" * 30)\n",
        "    print(f\"Country      : {information['country'].title()}\")\n",
        "    print(f\"Population   : About {information['population']:,}\")\n",
        "    print(f\"Language     : {information['language']}\")\n",
        "    print(f\"Famous Place : {information['famous_place']}\")\n",
        "    print(f\"Interesting Fact: {information['fact']}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },

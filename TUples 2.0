    {
      "cell_type": "markdown",
      "source": [
        "Looping Through a Dictionary’s Keys in a\n",
        "Particular Order"
      ],
      "metadata": {
        "id": "kBFzs6YI8qVY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "favorite_languages = {\n",
        "    'jen': 'python',\n",
        "    'sarah': 'c',\n",
        "    'edward': 'rust',\n",
        "    'phil': 'python',\n",
        "    }\n",
        "for names in sorted(favorite_languages.keys()):\n",
        "    print(f\"{names.title()}, thank you for taking the poll.\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fsPn9PBl9ZZ4",
        "outputId": "6ff68d7d-21c3-4556-a2d9-d191e05fcd97"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Edward, thank you for taking the poll.\n",
            "Jen, thank you for taking the poll.\n",
            "Phil, thank you for taking the poll.\n",
            "Sarah, thank you for taking the poll.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Looping Through All Values in a Dictionary"
      ],
      "metadata": {
        "id": "9E45q4Sz-CCn"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "favorite_languages = {\n",
        "    'jen': 'python',\n",
        "    'sarah': 'c',\n",
        "    'edward': 'rust',\n",
        "    'phil': 'python',\n",
        "    }\n",
        "print(\"The following languages have been mentioned:\")\n",
        "for language in favorite_languages.values():\n",
        "    print(language.title())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "3q6FBi-Y-NMG",

          "name": "stdout",
          "text": [
            "\n",
            "==============================\n",
            "CITY: MUMBAI\n",
            "==============================\n",
            "Country      : India\n",
            "Population   : About 20,000,000\n",
            "Language     : Marathi\n",
            "Famous Place : Gateway of India\n",
            "Interesting Fact: Mumbai is home to Bollywood.\n",
            "\n",
            "==============================\n",
            "CITY: PARIS\n",
